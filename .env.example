# PROCTOR Configuration\n# Copy this file to .env.local and customize values\n\n# ─── Detection Thresholds ───\nVITE_GAZE_THRESHOLD=8\nVITE_HEAD_THRESHOLD=8\nVITE_NOFACE_THRESHOLD=12\nVITE_MULTIFACE_THRESHOLD=5\nVITE_OBJECT_THRESHOLD=1\n\n# ─── MediaPipe Confidence ───\nVITE_FACE_MESH_CONF=0.4\nVITE_FACE_DETECTION_CONF=0.45\nVITE_COCO_CONFIDENCE=0.50\n\n# ─── Performance ───\nVITE_FRAME_SKIP_FACE=3\nVITE_FRAME_SKIP_OBJECT=5\nVITE_MAX_ALERTS=200\n\n# ─── Debug ───\nVITE_DEBUG_MODE=false\nVITE_LOG_DETECTION=false\n"